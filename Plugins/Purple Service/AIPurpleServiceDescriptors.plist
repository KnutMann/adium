<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	One entry per libpurple protocol that has no service class of its own, keyed by the protocol id
	the plugin registers itself under.

	Only what cannot be asked of the protocol belongs here. Whether it takes a password, whether it
	has group chats, whether accounts can be registered: the protocol answers all of that, and
	AIPurpleGenericService asks it.

	ServiceCodeUniqueID is written into every stored account and into the encryption key store. It
	is decided once and then never changes, whatever else about the protocol does.

	IconBaseName names two images in this bundle, "<base>-small" and "<base>-large".

	UserNameLabel is English here and is looked up in the usual string table at runtime, so a
	translated one keeps working.
-->
<plist version="1.0">
<dict>
	<key>telegram-tdlib</key>
	<dict>
		<key>ServiceCodeUniqueID</key>
		<string>libpurple-Telegram</string>
		<key>ServiceID</key>
		<string>Telegram</string>
		<key>ServiceClass</key>
		<string>Telegram</string>
		<key>ShortDescription</key>
		<string>Telegram</string>
		<key>LongDescription</key>
		<string>Telegram</string>
		<!-- The account name is the phone number in international format, +4917012345678 -->
		<key>UserNameLabel</key>
		<string>Phone Number</string>
		<key>AllowedCharacters</key>
		<string>+0123456789</string>
		<key>AllowedLength</key>
		<integer>20</integer>
		<key>CaseSensitive</key>
		<false/>
		<key>ServiceImportance</key>
		<string>Secondary</string>
		<key>IconBaseName</key>
		<string>Telegram</string>
		<!-- tdlib keeps its own connection; there is no host to probe -->
		<key>NetworkReachability</key>
		<false/>
		<!-- Store and forward: a file reaches a contact who looks offline -->
		<key>OfflineFileTransfers</key>
		<true/>
	</dict>

	<key>prpl-eionrobb-ircv3</key>
	<dict>
		<key>ServiceCodeUniqueID</key>
		<string>libpurple-IRCv3</string>
		<!--
			Its own service id, not "IRC": two services answering to one id make
			firstServiceWithServiceID: pick whichever the dictionary happens to hand back. The class
			stays IRC, which is what the url handler and the channel linker match on, so those keep
			working for an ircv3 account.
		-->
		<key>ServiceID</key>
		<string>IRCv3</string>
		<key>ServiceClass</key>
		<string>IRC</string>
		<key>ShortDescription</key>
		<string>IRC (v3)</string>
		<key>LongDescription</key>
		<string>IRC with IRCv3 capabilities</string>
		<key>UserNameLabel</key>
		<string>Nickname</string>
		<key>ServiceImportance</key>
		<string>Secondary</string>
		<!-- The images the built in IRC service already ships -->
		<key>IconBaseName</key>
		<string>irc</string>
		<!--
			IRC takes the server as part of the account name, "nick@irc.example.net", and declares no
			server option of its own. Without this the server field would have nothing to write to
			and would be hidden, leaving no way to say where to connect.
		-->
		<key>AccountNameIncludesHost</key>
		<true/>
	</dict>

	<key>prpl-hehoe-presage</key>
	<dict>
		<key>ServiceCodeUniqueID</key>
		<string>libpurple-Signal</string>
		<key>ServiceID</key>
		<string>Signal</string>
		<key>ServiceClass</key>
		<string>Signal</string>
		<key>ShortDescription</key>
		<string>Signal</string>
		<key>LongDescription</key>
		<string>Signal</string>
		<!--
			A name, not an address. Signal knows this account by a UUID which the plugin learns from
			the server on every connection; what is asked for here is only what the account is called
			in Adium, and it is what the message store is filed under. Worth choosing once and then
			leaving alone: renaming after linking means linking again.
		-->
		<key>UserNameLabel</key>
		<string>Account Name</string>
		<!--
			No AllowedCharacters. The hand written service excluded what would be trouble in a file
			name, which the generic side cannot express as a plain list, so this is a place where the
			descriptor is thinner than the class it replaces, and ForbiddenCharacters says the same
			thing from the other side.
		-->
		<key>ForbiddenCharacters</key>
		<string>/:\</string>
		<key>AllowedLength</key>
		<integer>64</integer>
		<key>CaseSensitive</key>
		<false/>
		<key>ServiceImportance</key>
		<string>Secondary</string>
		<key>IconBaseName</key>
		<string>Signal</string>
		<!-- presage keeps its own connection; there is no host to probe -->
		<key>NetworkReachability</key>
		<false/>
		<!-- The name is a name: hand it over as typed, not as formatted -->
		<key>AccountNameFromUID</key>
		<true/>
		<!-- presage echoes what was sent, including from the phone -->
		<key>EchoesOutgoingMessages</key>
		<true/>
		<!-- Store and forward, and presence is sparse -->
		<key>OfflineFileTransfers</key>
		<true/>
	</dict>

	<key>prpl-eionrobb-msteams</key>
	<dict>
		<key>ServiceCodeUniqueID</key>
		<string>libpurple-Teams</string>
		<key>ServiceID</key>
		<string>Teams</string>
		<key>ServiceClass</key>
		<string>Teams</string>
		<key>ShortDescription</key>
		<string>Teams</string>
		<key>LongDescription</key>
		<string>Microsoft Teams</string>
		<!--
			The name is not an address and nothing is looked up by it. Signing in happens in the
			browser, so this only has to tell two accounts apart, which is why the protocol calls it
			a placeholder.
		-->
		<key>UserNameLabel</key>
		<string>Account Name</string>
		<key>AllowedLength</key>
		<integer>64</integer>
		<key>CaseSensitive</key>
		<false/>
		<key>AccountNameFromUID</key>
		<true/>
		<key>ServiceImportance</key>
		<string>Secondary</string>
		<key>IconBaseName</key>
		<string>Teams</string>
		<!-- Teams knows people by their address, which is on their card anyway -->
		<key>UserNamesAreEmailAddresses</key>
		<true/>
		<!-- It keeps its own connection and reconnects itself; there is no host to probe -->
		<key>NetworkReachability</key>
		<false/>
	</dict>

	<!--
		The same plugin built a second time, against teams.live.com rather than teams.microsoft.com.
		A separate protocol id, so both can be used at once, and no tenant: a personal account
		belongs to nobody's organisation.
	-->
	<key>prpl-eionrobb-msteams-personal</key>
	<dict>
		<key>ServiceCodeUniqueID</key>
		<string>libpurple-TeamsPersonal</string>
		<key>ServiceID</key>
		<string>TeamsPersonal</string>
		<key>ServiceClass</key>
		<string>Teams</string>
		<key>ShortDescription</key>
		<string>Teams (Personal)</string>
		<key>LongDescription</key>
		<string>Microsoft Teams for personal accounts</string>
		<key>UserNameLabel</key>
		<string>Account Name</string>
		<key>AllowedLength</key>
		<integer>64</integer>
		<key>CaseSensitive</key>
		<false/>
		<key>AccountNameFromUID</key>
		<true/>
		<key>ServiceImportance</key>
		<string>Secondary</string>
		<key>IconBaseName</key>
		<string>TeamsPersonal</string>
		<!-- Teams knows people by their address, which is on their card anyway -->
		<key>UserNamesAreEmailAddresses</key>
		<true/>
		<key>NetworkReachability</key>
		<false/>
	</dict>
</dict>
</plist>
