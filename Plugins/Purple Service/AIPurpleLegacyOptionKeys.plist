<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Where a protocol option used to be kept, before options were read from the protocol itself.

	Each service had its own fields drawn into a nib and its own preference key for each of them,
	even though the protocol declared the same option all along. The rows come from the protocol now
	and are kept under "<protocol id>:<setting>", so the old value has to move once or the setting
	silently returns to its default.

	Keyed by protocol id, then by the old Adium key, giving the protocol's own setting name. Read
	once per account and option; the old key is left where it is, so going back a version does not
	lose anything.

	Only options the protocol actually declares belong here. A setting that is Adium's own, IRC's
	commands to send after connecting for instance, is not a protocol option and keeps its key and
	its own row.
-->
<plist version="1.0">
<dict>
	<key>prpl-irc</key>
	<dict>
		<key>IRC:Use SSL</key>
		<string>ssl</string>
		<key>IRC:Username</key>
		<string>username</string>
		<key>IRC:Realname</key>
		<string>realname</string>
		<key>IRC:Encoding</key>
		<string>encoding</string>
	</dict>

	<key>prpl-hehoe-whatsmeow</key>
	<dict>
		<key>WhatsApp:Ignore Status Broadcasts</key>
		<string>ignore-status-broadcast</string>
		<key>WhatsApp:Ignore Newsletters</key>
		<string>ignore-newsletters</string>
		<key>WhatsApp:Profile Pictures</key>
		<string>get-icons</string>
	</dict>

	<key>prpl-jabber</key>
	<dict>
		<key>Jabber:Connect Server</key>
		<string>connect_server</string>
		<key>Jabber:BOSH Server</key>
		<string>bosh_url</string>
		<!--
			Adium kept three separate switches for what the protocol has long expressed as one
			choice, so those do not move: "Use TLS", "Require TLS" and "Force Old SSL" together mean
			one of connection_security's values, and guessing which one from three booleans would be
			a decision rather than a move. The choice is offered directly now.
		-->
	</dict>
</dict>
</plist>
