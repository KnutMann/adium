syntax: glob
.DS_Store
*.mode*
*.pbxuser
*.perspectivev3
*.xcworkspace
*.xcuserdatad
build
# A measurement build goes into its own directory beside it, so that it never disturbs
# the one /Applications/Adium.app is a symbolic link to. Those are build output too.
/build-*
Icon
docs/*.html
Dependencies/build
Dependencies/source
Dependencies/Frameworks
Dependencies/build.log
Dependencies/error.log
Dependencies/framework_maker/*.pyc

Resources/*/LC_MESSAGES/
com.apple.DeveloperTools

# Build artefacts of the bundled dependencies: regenerated by a rebuild, never source
*.o
*.lo
*.a
*.la
.libs/

# Except these two, which are shipped: the codec voice notes are recorded in, a
# couple of megabytes beside the frameworks that are already here, so that a
# fresh clone needs neither a download nor an autotools toolchain to build.
!Frameworks/opus/lib/*.a

# Xcode per-user state
xcuserdata/
*.xcuserdatad/
*~
Testing/xmpp/peer/.venv/
# No trailing slash, and the same reason as Dependencies/webrtc/.gitignore gives: with one
# this matches only a directory, so a symbolic link put here to let a second worktree build
# without fetching again slips past, gets committed, and overwrites the real checkout with a
# link to itself on the next merge. That happened to both of them.
Dependencies/picomemo/picomemo

# Python leaves these beside frameworkize.py and its test
__pycache__/
