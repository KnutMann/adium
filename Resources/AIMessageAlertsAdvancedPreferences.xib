<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="22505" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="22505"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="AIMessageAlertsAdvancedPreferences">
            <connections>
                <outlet property="view" destination="paneView" id="oView"/>
                <outlet property="label_statusMenuItem" destination="lMenu" id="oLMenu"/>
                <outlet property="checkBox_statusMenuItemBadge" destination="cbBadge" id="oCbBadge"/>
                <outlet property="checkBox_statusMenuItemFlash" destination="cbFlash" id="oCbFlash"/>
                <outlet property="checkBox_statusMenuItemCount" destination="cbCount" id="oCbCount"/>
                <outlet property="label_dockIcon" destination="lDock" id="oLDock"/>
                <outlet property="label_dockIconWhenUnread" destination="lDockUnread" id="oLDockUnread"/>
                <outlet property="checkBox_animateDockIcon" destination="cbAnimate" id="oCbAnimate"/>
                <outlet property="checkBox_badgeDockIcon" destination="cbDockBadge" id="oCbDockBadge"/>
                <outlet property="label_dockMenuBarIconCounts" destination="lCounts" id="oLCounts"/>
                <outlet property="checkBox_unreadConversations" destination="cbConv" id="oCbConv"/>
                <outlet property="checkBox_unreadContentMention" destination="cbMention" id="oCbMention"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="paneView">
            <rect key="frame" x="0.0" y="0.0" width="384" height="274"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <box verticalHuggingPriority="750" fixedFrame="YES" boxType="separator" translatesAutoresizingMaskIntoConstraints="NO" id="sepMenu">
                    <rect key="frame" x="4" y="255" width="375" height="5"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                </box>
                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lMenu">
                    <rect key="frame" x="1" y="257" width="326" height="14"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="left" controlSize="small" title="Status Menu Item" id="lMenuC">
                        <font key="font" metaFont="smallSystemBold"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbBadge">
                    <rect key="frame" x="0.0" y="235" width="380" height="16"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Badge the menu item with current status" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbBadgeC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections><action selector="changePreference:" target="-2" id="aCbBadge"/></connections>
                </button>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbFlash">
                    <rect key="frame" x="0.0" y="215" width="380" height="16"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Flash when there are unread messages" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbFlashC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections><action selector="changePreference:" target="-2" id="aCbFlash"/></connections>
                </button>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbCount">
                    <rect key="frame" x="0.0" y="193" width="380" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Show unread message count in the menu bar" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbCountC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections><action selector="changePreference:" target="-2" id="aCbCount"/></connections>
                </button>
                <box verticalHuggingPriority="750" fixedFrame="YES" boxType="separator" translatesAutoresizingMaskIntoConstraints="NO" id="sepDock">
                    <rect key="frame" x="3" y="171" width="376" height="5"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                </box>
                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lDock">
                    <rect key="frame" x="0.0" y="170" width="326" height="17"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="left" controlSize="small" title="Dock Icon" id="lDockC">
                        <font key="font" metaFont="smallSystemBold"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lDockUnread">
                    <rect key="frame" x="0.0" y="148" width="380" height="17"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="left" controlSize="small" title="When there are unread messages:" id="lDockUnreadC">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbAnimate">
                    <rect key="frame" x="18" y="130" width="362" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Animate the dock icon" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbAnimateC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections><action selector="changePreference:" target="-2" id="aCbAnimate"/></connections>
                </button>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbDockBadge">
                    <rect key="frame" x="18" y="110" width="362" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Display a message count badge" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbDockBadgeC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections><action selector="changePreference:" target="-2" id="aCbDockBadge"/></connections>
                </button>
                <box verticalHuggingPriority="750" fixedFrame="YES" boxType="separator" translatesAutoresizingMaskIntoConstraints="NO" id="sepCounts">
                    <rect key="frame" x="3" y="88" width="376" height="5"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                </box>
                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lCounts">
                    <rect key="frame" x="0.0" y="87" width="326" height="17"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="left" controlSize="small" title="Dock Icon and Status Menu Item Counts" id="lCountsC">
                        <font key="font" metaFont="smallSystemBold"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbConv">
                    <rect key="frame" x="0.0" y="63" width="380" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Count unread conversations instead of unread messages" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbConvC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections><action selector="changePreference:" target="-2" id="aCbConv"/></connections>
                </button>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbMention">
                    <rect key="frame" x="0.0" y="43" width="380" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Only count number of highlights and mentions for group chats" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbMentionC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections><action selector="changePreference:" target="-2" id="aCbMention"/></connections>
                </button>
            </subviews>
        </customView>
    </objects>
</document>
