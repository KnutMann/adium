<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="22505" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="22505"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="ESContactListAdvancedPreferences">
            <connections>
                <outlet property="view" destination="paneView" id="oView"/>
                <outlet property="label_appearance" destination="lAppearance" id="oLAppearance"/>
                <outlet property="checkBox_flash" destination="cbFlash" id="oCbFlash"/>
                <outlet property="checkBox_animateChanges" destination="cbAnimate" id="oCbAnimate"/>
                <outlet property="checkBox_showOnAllSpaces" destination="cbSpaces" id="oCbSpaces"/>
                <outlet property="checkBox_windowHasShadow" destination="cbShadow" id="oCbShadow"/>
                <outlet property="label_tooltips" destination="lTooltips" id="oLTooltips"/>
                <outlet property="checkBox_showTooltips" destination="cbTooltips" id="oCbTooltips"/>
                <outlet property="checkBox_showTooltipsInBackground" destination="cbTooltipsBg" id="oCbTooltipsBg"/>
                <outlet property="label_windowHandling" destination="lWinHandling" id="oLWinHandling"/>
                <outlet property="label_hide" destination="lHide" id="oLHide"/>
                <outlet property="matrix_hiding" destination="mxHiding" id="oMxHiding"/>
                <outlet property="checkBox_hideOnScreenEdgesOnlyInBackground" destination="cbEdgesBg" id="oCbEdgesBg"/>
                <outlet property="label_orderTheContactList" destination="lOrder" id="oLOrder"/>
                <outlet property="popUp_windowPosition" destination="pWinPos" id="oPWinPos"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="paneView" userLabel="Contact List">
            <rect key="frame" x="0.0" y="0.0" width="317" height="337"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbEdgesBg">
                    <rect key="frame" x="37" y="67" width="257" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="...only while Adium is in the background" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbEdgesBgC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections>
                        <action selector="changePreference:" target="-2" id="aCbEdgesBg"/>
                        <binding destination="-2" name="value" keyPath="adium.preferenceController.Contact List.Hide By Sliding Only in Background" id="bCbEdgesBg1"/>
                        <binding destination="-2" name="enabled" keyPath="hideOnScreenEdgesOnlyInBackgroundEnabled" id="bCbEdgesBg2"/>
                    </connections>
                </button>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbFlash">
                    <rect key="frame" x="0.0" y="299" width="304" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Flash names with unviewed messages" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbFlashC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections>
                        <binding destination="-2" name="value" keyPath="adium.preferenceController.Contact List.Flash Unviewed Content" id="bCbFlash"/>
                    </connections>
                </button>
                <box verticalHuggingPriority="750" fixedFrame="YES" boxType="separator" translatesAutoresizingMaskIntoConstraints="NO" id="sepWin">
                    <rect key="frame" x="3" y="173" width="311" height="5"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                </box>
                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lWinHandling">
                    <rect key="frame" x="0.0" y="175" width="304" height="14"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="left" controlSize="small" title="Window Handling" id="lWinHandlingC">
                        <font key="font" metaFont="smallSystemBold"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lOrder">
                    <rect key="frame" x="0.0" y="47" width="122" height="14"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="right" controlSize="small" title="Show the contact list: " id="lOrderC">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <popUpButton verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="pWinPos">
                    <rect key="frame" x="124" y="42" width="163" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" controlSize="small" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" arrowPosition="arrowAtCenter" preferredEdge="maxY" id="pWinPosC">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                        <menu key="menu" id="pWinPosM"/>
                    </popUpButtonCell>
                    <connections><action selector="changePreference:" target="-2" id="aPWinPos"/></connections>
                </popUpButton>
                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lAppearance">
                    <rect key="frame" x="0.0" y="323" width="305" height="14"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="left" controlSize="small" title="Appearance" id="lAppearanceC">
                        <font key="font" metaFont="smallSystemBold"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <box verticalHuggingPriority="750" fixedFrame="YES" boxType="separator" translatesAutoresizingMaskIntoConstraints="NO" id="sepAppearance">
                    <rect key="frame" x="3" y="321" width="311" height="5"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                </box>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbAnimate">
                    <rect key="frame" x="0.0" y="279" width="304" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Animate changes" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbAnimateC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections>
                        <action selector="changePreference:" target="-2" id="aCbAnimate"/>
                        <binding destination="-2" name="value" keyPath="adium.preferenceController.Contact List.Animate Changes" id="bCbAnimate"/>
                    </connections>
                </button>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbTooltipsBg">
                    <rect key="frame" x="17" y="195" width="286" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="While Adium is in the background" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbTooltipsBgC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections>
                        <binding destination="-2" name="enabled" keyPath="adium.preferenceController.Contact List.Show Tooltips" id="bCbTooltipsBg1"/>
                        <binding destination="-2" name="value" keyPath="adium.preferenceController.Contact List.Show Tooltips in Background" id="bCbTooltipsBg2"/>
                    </connections>
                </button>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbTooltips">
                    <rect key="frame" x="-1" y="215" width="304" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Show contact information tooltips" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbTooltipsC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections>
                        <binding destination="-2" name="value" keyPath="adium.preferenceController.Contact List.Show Tooltips" id="bCbTooltips"/>
                    </connections>
                </button>
                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lTooltips">
                    <rect key="frame" x="0.0" y="239" width="304" height="14"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="left" controlSize="small" title="Tooltips" id="lTooltipsC">
                        <font key="font" metaFont="smallSystemBold"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <box verticalHuggingPriority="750" fixedFrame="YES" boxType="separator" translatesAutoresizingMaskIntoConstraints="NO" id="sepTooltips">
                    <rect key="frame" x="3" y="237" width="311" height="5"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                </box>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbShadow">
                    <rect key="frame" x="0.0" y="259" width="139" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Show window shadow" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbShadowC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections>
                        <binding destination="-2" name="value" keyPath="adium.preferenceController.Contact List.Window Has Shadow" id="bCbShadow"/>
                    </connections>
                </button>
                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lHide">
                    <rect key="frame" x="0.0" y="153" width="305" height="14"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="left" controlSize="small" title="Automatically hide the contact list:" id="lHideC">
                        <font key="font" metaFont="smallSystem"/>
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <matrix verticalHuggingPriority="750" fixedFrame="YES" mode="radio" allowsEmptySelection="NO" autosizesCells="NO" translatesAutoresizingMaskIntoConstraints="NO" id="mxHiding">
                    <rect key="frame" x="18" y="89" width="297" height="58"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                    <size key="cellSize" width="297" height="18"/>
                    <size key="intercellSpacing" width="4" height="2"/>
                    <buttonCell key="prototype" type="radio" title="Radio" imagePosition="left" alignment="left" controlSize="small" inset="2" id="mxHidingProto">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <cells>
                        <column>
                            <buttonCell type="radio" title="Never" imagePosition="left" alignment="left" controlSize="small" state="on" inset="2" id="mxHidingNever">
                                <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                <font key="font" metaFont="smallSystem"/>
                            </buttonCell>
                            <buttonCell type="radio" title="When Adium is in the background" imagePosition="left" alignment="left" controlSize="small" tag="1" inset="2" id="mxHidingBg">
                                <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                <font key="font" metaFont="smallSystem"/>
                            </buttonCell>
                            <buttonCell type="radio" title="On screen edges" imagePosition="left" alignment="left" controlSize="small" tag="2" inset="2" id="mxHidingEdges">
                                <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                                <font key="font" metaFont="smallSystem"/>
                            </buttonCell>
                        </column>
                    </cells>
                    <connections>
                        <action selector="changePreference:" target="-2" id="aMxHiding"/>
                        <binding destination="-2" name="selectedTag" keyPath="adium.preferenceController.Contact List.Window Hiding Style" id="bMxHiding"/>
                    </connections>
                </matrix>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="cbSpaces">
                    <rect key="frame" x="17" y="23" width="123" height="18"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="check" title="Show on all spaces" bezelStyle="regularSquare" imagePosition="left" alignment="left" controlSize="small" inset="2" id="cbSpacesC">
                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
                        <font key="font" metaFont="smallSystem"/>
                    </buttonCell>
                    <connections>
                        <action selector="changePreference:" target="-2" id="aCbSpaces"/>
                        <binding destination="-2" name="value" keyPath="adium.preferenceController.Contact List.Show Contact List On All Spaces" id="bCbSpaces"/>
                    </connections>
                </button>
            </subviews>
        </customView>
    </objects>
</document>
