                <outlet property="button_customizeEmoticons" destination="bEmo" id="oBEmo"/>
                <outlet property="button_showAllDockIcons" destination="bDck" id="oBDck"/>
                <outlet property="button_customizeColorTheme" destination="bThm" id="oBThm"/>
                <outlet property="button_customizeListLayout" destination="bLay" id="oBLay"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="paneView">
            <rect key="frame" x="0.0" y="0.0" width="540" height="400"/>
            <autoresizingMask key="autoresizingMask"/>
            <subviews>
                <textField horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="lSvc">
                    <rect key="frame" x="7" y="362" width="150" height="17"/>
