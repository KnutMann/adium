<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="22505" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="22505"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="AIAppearancePreferences">
            <connections>
                <outlet property="view" destination="paneView" id="oView"/>
                <outlet property="popUp_serviceIcons" destination="pSvc" id="oPSvc"/>
                <outlet property="popUp_statusIcons" destination="pSta" id="oPSta"/>
                <outlet property="popUp_menuBarIcons" destination="pMbi" id="oPMbi"/>
                <outlet property="popUp_emoticons" destination="pEmo" id="oPEmo"/>
                <outlet property="popUp_dockIcon" destination="pDck" id="oPDck"/>
                <outlet property="popUp_colorTheme" destination="pThm" id="oPThm"/>
                <outlet property="popUp_listLayout" destination="pLay" id="oPLay"/>
                <outlet property="popUp_windowStyle" destination="pWin" id="oPWin"/>
                <outlet property="checkBox_verticalAutosizing" destination="cbV" id="oCbV"/>
                <outlet property="checkBox_horizontalAutosizing" destination="cbH" id="oCbH"/>
                <outlet property="slider_windowOpacity" destination="sOpa" id="oSOpa"/>
                <outlet property="textField_windowOpacity" destination="tOpa" id="oTOpa"/>
                <outlet property="slider_horizontalWidth" destination="sWid" id="oSWid"/>
