<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- STATUS_STATE_ID_NONE: "Do not change", which is what the removed "Auto Away" checkbox
	     defaulted to. The two below keep -1000 (Generic Away), because their checkboxes defaulted
	     to on and going away behind a screen saver or a fast user switch is what Adium always did. -->
	<key>Auto Away Status State ID</key>
	<integer>-2000</integer>
	<key>Away Reminder</key>
	<false/>
	<key>Away Reminder Interval</key>
	<integer>1800</integer>
	<key>Fast User Switching Status State ID</key>
	<integer>-1000</integer>
	<key>Report Idle</key>
	<true/>
	<key>Report Idle Interval</key>
	<integer>600</integer>
	<key>ScreenSaver Status State ID</key>
	<integer>-1000</integer>
	<key>Unread Mentions</key>
	<true/>
</dict>
</plist>
