LIBRARY_SEARCH_PATHS = "$(SRCROOT)" $(inherited) $(LIBRARY_SEARCH_PATHS_QUOTED_FOR_TARGET_1)
HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_1 = "$(SRCROOT)/Frameworks/libpurple.framework/Headers"
HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_2 = "$(SRCROOT)/Frameworks/libglib.framework/Headers"
HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_3 = "$(SRCROOT)/Frameworks/libintl.framework/Headers"
HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_4 = "$(SRCROOT)/Frameworks/libgstreamer.framework/Headers"
HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_5 = "$(SDKROOT)/usr/include/libxml2"
HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_libgthread = "$(SRCROOT)/Frameworks/libgthread.framework/Headers"
// picomemo carries the cryptography of OMEMO. Fetched and built by Dependencies/picomemo/fetch-picomemo.sh,
// pinned to one commit, so the headers live where that script puts them rather than in the tree.
HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_picomemo = "$(SRCROOT)/Dependencies/picomemo/picomemo/gen"
// OpenSSL's own headers, for the AES-GCM that encrypted file sharing (XEP-0454) needs.
// They have to be the headers of the library named at the end of OTHER_LDFLAGS below,
// Frameworks/libcrypto.3.dylib, which Dependencies/phases/build_openssl.sh builds and
// installs into Dependencies/build. That one is pinned to OpenSSL's long term support
// branch while Homebrew tracks the newest one, so compiling here against Homebrew and
// linking there against ours is how the two drift apart - and what drift produces is not
// a compiler error, it is a symbol that is missing when the application starts. Our own
// prefix therefore comes first.
// The two Homebrew layouts stay behind it so that a checkout which has not built the
// dependencies yet still compiles; a search path that does not exist is simply ignored.
HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_openssl = "$(SRCROOT)/Dependencies/build/include" "/opt/homebrew/opt/openssl@3/include" "/usr/local/opt/openssl@3/include"
LIBRARY_SEARCH_PATHS_QUOTED_FOR_TARGET_1 = "$(SDKROOT)/usr/lib"
PRODUCT_NAME = AdiumLibpurple
SKIP_INSTALL = YES
DYLIB_CURRENT_VERSION = 1
// libintl.framework, and there is only one now, which is the point. The bundle used to carry a second
// copy as libintl8.framework: same thirteen symbols, and either one would happily translate a string.
// What they did not share is state. bind_textdomain_codeset in adiumPurpleCoreUiInit records the
// output encoding in the table of whichever copy the caller was linked against, and libpurple, glib
// and gio all read the table in libintl.framework. Linking libintl8 here set the encoding in a table
// nobody consulted, so libpurple fell back to the locale charset and transliterated its German down
// to ASCII: "Ubertragung der Datei" instead of "Übertragung der Datei".
// libpicomemo.a is the cryptography of OMEMO, linked in statically; it calls the OpenSSL this
// application already ships for Telegram, which is why libcrypto appears here as well.
OTHER_LDFLAGS = -lsasl2 "$(SRCROOT)/Frameworks/libintl.framework/Versions/8/libintl" "$(SRCROOT)/Dependencies/picomemo/picomemo/o/libpicomemo.a" "$(SRCROOT)/Frameworks/libcrypto.3.dylib"
INFOPLIST_FILE = Plists/AdiumLibpurple/Info.plist
DYLIB_COMPATIBILITY_VERSION = 1
LD_RUNPATH_SEARCH_PATHS = @executable_path/../Frameworks
HEADER_SEARCH_PATHS = $(HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_1) $(HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_2) $(HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_3) $(HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_4) $(HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_5) $(HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_libgthread) $(HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_picomemo) $(HEADER_SEARCH_PATHS_QUOTED_FOR_TARGET_openssl)
INSTALL_PATH = @executable_path/../Frameworks
FRAMEWORK_VERSION = A
GCC_PREPROCESSOR_DEFINITIONS = $(value) ENABLE_NLS HAVE_CDSA
MACOSX_DEPLOYMENT_TARGET = 12.0
