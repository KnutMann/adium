<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>FMWK</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- install_framework_plist fills this in from LIBPURPLE_VERSION, which
	     phases/build_purple.sh reads out of the version.h the release ships. It used
	     to read 0.0.1d1, which named no release of anything. -->
	<key>CFBundleShortVersionString</key>
	<string>@FRAMEWORK_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@FRAMEWORK_VERSION@</string>
	<!-- Load bearing, unlike the identifier of any other framework here:
	     adiumPurpleCore.m calls bindtextdomain with the resource path of the bundle
	     it finds under this name, so libpurple's own translations are reached
	     through it. It is not ours to rename. -->
	<key>CFBundleIdentifier</key>
	<string>im.pidgin.libpurple</string>
</dict>
</plist>
