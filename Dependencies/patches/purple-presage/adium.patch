diff --git a/src/c/presage.h b/src/c/presage.h
index f0fd7e1..4795cfa 100755
--- a/src/c/presage.h
+++ b/src/c/presage.h
@@ -9,6 +9,22 @@
 extern const char * PRESAGE_STARTUP_DELAY_SECONDS_OPTION;
 extern const char * PRESAGE_ATTACHMENT_PATH_TEMPLATE_OPTION;
 
+/* Stack for the thread the Rust runtime is started on. It has to match the tokio worker stack size
+ * set in bridge.rs, where a note records that 25 MB was found to be too little. */
+#define PRESAGE_THREAD_STACK_SIZE (32 * 1024 * 1024)
+
+/* The account's own Signal identity, as the back-end reports it. Not a user setting: it is written
+ * once the connection is up and read wherever this account has to name itself. Kept apart from the
+ * username because the two are not the same thing, and asking the user for this one is asking for
+ * something they cannot know before they have linked. */
+#define PRESAGE_OWN_UUID_SETTING "own-uuid"
+
+/*!
+ * How this account refers to itself: the UUID the back-end reported, or the username while no
+ * connection has yet reported one. Never NULL for an account that has connected once.
+ */
+const char *presage_own_uuid(PurpleAccount *account);
+
