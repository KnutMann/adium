+/*
+ * Does this name have the shape of a Signal contact identifier?
+ *
+ * A UUID as text: 36 characters, hexadecimal, hyphens in the four canonical places. Deliberately a
+ * shape test and not a parse: the point is to keep things that are obviously not contacts, group
+ * identifiers above all, out of code paths that can only deal with contacts.
+ */
+gboolean presage_uuid_looks_valid(const char *who) {
+    if (who == NULL || strlen(who) != 36) {
+        return FALSE;
+    }
+
+    for (int i = 0; i < 36; i++) {
+        if (i == 8 || i == 13 || i == 18 || i == 23) {
+            if (who[i] != '-') return FALSE;
+        } else if (!g_ascii_isxdigit(who[i])) {
+            return FALSE;
+        }
+    }
+
+    return TRUE;
+}
