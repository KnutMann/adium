 #include "presage.h"
 
+/*
+ * How this account refers to itself.
+ *
+ * The back-end reports the account's UUID on every connection, not only on the first one, because
+ * presage_rust_whoami is asked for it as soon as the channel to the runtime exists. Storing it means
+ * this account can name itself correctly from the moment it connects, without the username ever
+ * having to be the UUID.
+ *
+ * Falling back to the username covers two cases: the moments before the first report arrives, and
+ * accounts set up the old way, where the username had to be the UUID and therefore already is one.
+ */
+const char *presage_own_uuid(PurpleAccount *account) {
+    const char *uuid = purple_account_get_string(account, PRESAGE_OWN_UUID_SETTING, NULL);
+    if (uuid != NULL && uuid[0] != '\0') {
+        return uuid;
+    }
+    return purple_account_get_username(account);
+}
