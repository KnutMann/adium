+/*
+ * Fetches each contact's profile picture and hands it over as a file.
+ *
+ * Separate from forward_contacts and spawned rather than awaited, because this talks to the server:
+ * presage caches an avatar in its store after the first fetch, but the first time round this is one
+ * request per contact, and doing that before the receive loop starts would hold up the whole login
+ * for as long as it takes.
+ *
+ * The bytes travel as a file for the same reason attachments do: nothing larger than a string
+ * crosses this FFI boundary, and inventing an ownership contract for a buffer is not worth it for a
+ * few kilobytes. The C side reads the file and removes it.
+ */
+pub async fn forward_avatars<C: presage::store::Store + 'static>(
+    account: *mut crate::bridge_structs::PurpleAccount,
+    mut manager: presage::Manager<C, presage::manager::Registered>,
+    avatar_directory: std::path::PathBuf,
+) {
+    let contacts = match manager.store().contacts().await {
+        Err(err) => {
+            crate::bridge::purple_debug(account, crate::bridge_structs::PURPLE_DEBUG_ERROR, format!("Unable to get contacts for avatars due to {err:?}\n"));
+            return;
+        }
+        Ok(contacts) => contacts.flatten().collect::<Vec<_>>(),
+    };
+
+    if let Err(err) = std::fs::create_dir_all(&avatar_directory) {
+        crate::bridge::purple_debug(account, crate::bridge_structs::PURPLE_DEBUG_ERROR, format!("Unable to create avatar directory due to {err}\n"));
+        return;
+    }
+
+    for contact in contacts {
+        // A contact with no profile key is one whose profile we are not allowed to read.
+        let key: [u8; 32] = match contact.profile_key.clone().try_into() {
+            Ok(key) => key,
+            Err(_) => continue,
+        };
+        let profile_key = presage::libsignal_service::prelude::ProfileKey::create(key);
+
+        let avatar = match manager.retrieve_profile_avatar_by_uuid(contact.uuid, profile_key).await {
+            Ok(Some(avatar)) => avatar,
+            Ok(None) => continue,
+            Err(err) => {
+                crate::bridge::purple_debug(account, crate::bridge_structs::PURPLE_DEBUG_INFO, format!("No avatar for {}: {err}\n", contact.uuid));
+                continue;
+            }
+        };
+
+        let path = avatar_directory.join(contact.uuid.to_string());
+        if let Err(err) = std::fs::write(&path, &avatar) {
+            crate::bridge::purple_debug(account, crate::bridge_structs::PURPLE_DEBUG_ERROR, format!("Unable to write avatar due to {err}\n"));
+            continue;
+        }
+
+        crate::bridge::append_message(crate::bridge::Message {
+            account: account,
+            who: Some(contact.uuid.to_string()),
+            avatar_path: Some(path.to_string_lossy().into_owned()),
+            ..Default::default()
+        });
+    }
+
+    /* Groups have pictures too, and the same round trip applies. Collected before the loop because
+     * iterating the store borrows it while retrieve_group_avatar wants the manager mutably. */
+    let groups = match manager.store().groups().await {
+        Err(err) => {
+            crate::bridge::purple_debug(account, crate::bridge_structs::PURPLE_DEBUG_ERROR, format!("Unable to get groups for avatars due to {err:?}\n"));
+            return;
+        }
+        Ok(groups) => groups.flatten().collect::<Vec<_>>(),
+    };
+
+    for (master_key, group) in groups {
+        let context = presage::proto::GroupContextV2 {
+            master_key: Some(master_key.to_vec()),
+            revision: Some(group.revision),
+            ..Default::default()
+        };
+
+        let avatar = match manager.retrieve_group_avatar(context).await {
+            Ok(Some(avatar)) => avatar,
+            Ok(None) => continue,
+            Err(err) => {
+                crate::bridge::purple_debug(account, crate::bridge_structs::PURPLE_DEBUG_INFO, format!("No avatar for group {}: {err}\n", hex::encode(master_key)));
+                continue;
+            }
+        };
+
+        // the same identifier the group is known by everywhere else in this plug-in
+        let identifier = hex::encode(master_key);
+        let path = avatar_directory.join(&identifier);
+        if let Err(err) = std::fs::write(&path, &avatar) {
+            crate::bridge::purple_debug(account, crate::bridge_structs::PURPLE_DEBUG_ERROR, format!("Unable to write group avatar due to {err}\n"));
+            continue;
+        }
+
+        crate::bridge::append_message(crate::bridge::Message {
+            account: account,
+            who: Some(identifier),
+            avatar_path: Some(path.to_string_lossy().into_owned()),
+            ..Default::default()
+        });
+    }
+}
