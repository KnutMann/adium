-    int err = pthread_create(&presage_thread, NULL, rust_main, (void *)account);
+    pthread_attr_t presage_thread_attr;
+    pthread_attr_init(&presage_thread_attr);
+    /* The same stack the Windows branch above asks for, and for the same reason. pthread's default
+     * is not the 8 MB it is on Linux: macOS gives a thread 512 KB and does not grow it, while this
+     * code path wants tens of megabytes, as the note beside the tokio builder in bridge.rs records.
+     * Without this the runtime walks off the end of its stack somewhere inside the first URL it
+     * parses, and what the user sees is the application disappearing a second after the account
+     * connects. */
+    pthread_attr_setstacksize(&presage_thread_attr, PRESAGE_THREAD_STACK_SIZE);
+    int err = pthread_create(&presage_thread, &presage_thread_attr, rust_main, (void *)account);
