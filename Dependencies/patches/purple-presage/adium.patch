@@ -1,6 +1,66 @@
 #include "presage.h"
+#include <glib/gstdio.h> // g_rename, which respects the encoding rules on the platforms that have them
+
+/*
+ * Move the store to the name the account is about to be given.
+ *
+ * The store is named after the username, and the username is what the user typed before anything
+ * knew the account's real UUID. Linking therefore lands in a store called after a placeholder, and
+ * the error telling the user to correct the username also, on its own, invalidates the work: the
+ * corrected name points at a store that does not exist, so the QR code comes back and the device
+ * linked a minute ago sits on the account doing nothing. Moving the store instead means the second
+ * attempt finds what the first one did, and there is one scan rather than two.
+ *
+ * Called only from rust_main_finished, and that is the point of it. Renaming a SQLite database out
+ * from under an open connection is a way to lose data quietly; here the runtime has returned, so
+ * everything is closed.
+ */
+static void presage_move_store_to_uuid(PurpleAccount *account) {
+    const char *uuid = purple_account_get_string(account, PRESAGE_PENDING_UUID_SETTING, NULL);
+    if (uuid == NULL || uuid[0] == '\0') {
+        return;
+    }
+    purple_account_set_string(account, PRESAGE_PENDING_UUID_SETTING, "");
+
+    const char *username = purple_account_get_username(account);
+    if (username == NULL || purple_strequal(username, uuid)) {
+        return;
+    }
+
+    const char *user_dir = purple_user_dir();
+    // the write ahead log and its shared memory file belong to the database and move with it
+    const char * const suffixes[] = {"", "-wal", "-shm"};
+    gchar *from[G_N_ELEMENTS(suffixes)];
+    gchar *to[G_N_ELEMENTS(suffixes)];
+    for (gsize i = 0; i < G_N_ELEMENTS(suffixes); i++) {
+        from[i] = g_strdup_printf("%s/presage/%s.db3%s", user_dir, username, suffixes[i]);
+        to[i] = g_strdup_printf("%s/presage/%s.db3%s", user_dir, uuid, suffixes[i]);
+    }
+
+    /* Refuse rather than overwrite. A store already under the real name means this account has been
+     * linked before, and that one is the one worth keeping. */
+    if (!g_file_test(from[0], G_FILE_TEST_EXISTS)) {
+        purple_debug_info(PLUGIN_NAME, "no store at %s to move.\n", from[0]);
+    } else if (g_file_test(to[0], G_FILE_TEST_EXISTS)) {
+        purple_debug_info(PLUGIN_NAME, "not moving store: %s already exists.\n", to[0]);
+    } else {
+        for (gsize i = 0; i < G_N_ELEMENTS(suffixes); i++) {
+            if (g_file_test(from[i], G_FILE_TEST_EXISTS) && g_rename(from[i], to[i]) != 0) {
+                purple_debug_error(PLUGIN_NAME, "failed to move %s to %s.\n", from[i], to[i]);
+            }
+        }
+        purple_debug_info(PLUGIN_NAME, "moved store to %s.\n", to[0]);
+    }
+
+    for (gsize i = 0; i < G_N_ELEMENTS(suffixes); i++) {
+        g_free(from[i]);
+        g_free(to[i]);
+    }
+}
 
 static gboolean rust_main_finished(gpointer account) {
+    presage_move_store_to_uuid(account);
+
     PurpleConnection *connection = purple_account_get_connection(account);
     if (connection == NULL) {
         purple_debug_info(PLUGIN_NAME, "rust runtime has finished after connection ceased to exist.\n");
