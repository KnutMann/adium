+
+    /* Note the phone number down where a user interface can find it.
+     *
+     * A buddy here is named after the Telegram user id, because a name has to be stable and unique
+     * and a phone number is neither. The number is known all the same, and it went only into the
+     * info dialog, as a line of text assembled when somebody opens it. That is a fine place to read
+     * it and no place at all to look it up: an interface that wants to match this person against an
+     * address book has nothing to match on.
+     *
+     * Telegram hands out a contact's number only when they share it, so this is often empty, and
+     * empty is written as the absence of the setting rather than as a blank string. */
+    if (user.phone_number_.empty())
+        purple_blist_node_remove_setting(PURPLE_BLIST_NODE(buddy), BuddyOptions::PhoneNumber);
+    else
+        purple_blist_node_set_string(PURPLE_BLIST_NODE(buddy), BuddyOptions::PhoneNumber,
+                                     user.phone_number_.c_str());
 }
 
