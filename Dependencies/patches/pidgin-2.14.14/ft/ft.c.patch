+/*
+ * What to call the other end of a transfer in a message shown to the user.
+ *
+ * A buddy alias where there is a buddy, as before. The addition is the second step: a transfer does
+ * not have to address a buddy. Where a protocol lets one address a chat, purple_find_buddy returns
+ * nothing and the name fell through to xfer->who, which is whatever identifier the protocol uses
+ * internally. For a WhatsApp group that reads "Offering to send formula.png to
+ * 120363428551123670@g.us", in the middle of a sentence that is otherwise plain language, and the
+ * user has no way to tell which of their groups that is.
+ *
+ * The conversation is the right place to ask, because these strings are written into a conversation
+ * and purple_xfer_conversation_write_internal looks one up by the same name. If there is none, the
+ * message is not shown at all, so the title is available whenever the name is actually needed.
+ */
+static const char *
+purple_xfer_get_remote_alias(PurpleXfer *xfer)
+{
+	PurpleBuddy *buddy;
+	PurpleConversation *conv;
 
+	g_return_val_if_fail(xfer != NULL, NULL);
 
+	buddy = purple_find_buddy(xfer->account, xfer->who);
+	if (buddy != NULL)
+		return purple_buddy_get_alias(buddy);
+
+	conv = purple_find_conversation_with_account(PURPLE_CONV_TYPE_ANY, xfer->who,
+	                                            purple_xfer_get_account(xfer));
+	if (conv != NULL)
+		return purple_conversation_get_title(conv);
+
+	return xfer->who;
+}
