+/* Adium: hand a delivered message's id up to the UI just before the body, so a
+ * reaction or a read marker that later names the message by that id can be tied
+ * back to the one that was shown. The id is dropped by serv_got_im otherwise. */
+typedef void (*jabber_message_id_cb)(PurpleConnection *gc, const char *from, const char *id);
+static jabber_message_id_cb message_id_cb = NULL;
+
+void jabber_set_message_id_cb(jabber_message_id_cb cb)
+{
+	message_id_cb = cb;
+}
+
+/* Adium: the same for a message we send. The id is minted here and never returned to the UI, so a
+ * reaction the other side sends back to our message would have nothing to match; hand it up. */
+typedef void (*jabber_outgoing_message_id_cb)(PurpleConnection *gc, const char *to, const char *id);
+static jabber_outgoing_message_id_cb outgoing_message_id_cb = NULL;
+
+void jabber_set_outgoing_message_id_cb(jabber_outgoing_message_id_cb cb)
+{
+	outgoing_message_id_cb = cb;
+}
+
+/* Adium: a room message carries no id of its own that anyone else can name; the room stamps its
+ * own stanza-id (XEP-0359) and that is what a reaction in the room points at. Hand that up before
+ * the message is shown, so the reaction can find it the same way the one-to-one id does. */
+typedef void (*jabber_groupchat_message_id_cb)(PurpleConnection *gc, const char *id);
+static jabber_groupchat_message_id_cb groupchat_message_id_cb = NULL;
+
+void jabber_set_groupchat_message_id_cb(jabber_groupchat_message_id_cb cb)
+{
+	groupchat_message_id_cb = cb;
+}
