+/* Asks the server to say how much it has received, and stops the timer that would have. */
+static void
+jabber_sm_request_ack(JabberStream *js)
+{
+	xmlnode *req;
+
+	if (js->sm_request_timer != 0) {
+		purple_timeout_remove(js->sm_request_timer);
+		js->sm_request_timer = 0;
+	}
+	js->sm_unrequested = 0;
+
+	req = xmlnode_new("r");
+	xmlnode_set_namespace(req, NS_STREAM_MANAGEMENT);
+	jabber_send(js, req);
+	xmlnode_free(req);
+}
+
+static gboolean
+jabber_sm_request_ack_now(gpointer data)
+{
+	JabberStream *js = data;
+
+	js->sm_request_timer = 0;
+	if (js->sm_state == SM_REQUESTED || js->sm_state == SM_ENABLED)
+		jabber_sm_request_ack(js);
+
+	return FALSE;
+}
+
+/* Asks now, whatever the counting says, to find out whether the stream is still there.
+ *
+ * After a network comes back, the socket underneath may be dead without anything having noticed:
+ * nothing is read from a socket that carries nothing, and the next write may be minutes away.
+ * Measured on a wireless network being changed, it took 59 seconds for the connection to be
+ * declared lost, and for all of that time the application looked connected and was not.
+ *
+ * A write settles it at once, because a write to a socket that is gone fails and is reported.
+ * An <r/> is the right write: it is two dozen bytes, and after an interruption "how much did you
+ * receive" is a question genuinely worth asking rather than a poke.
+ */
+static gboolean
+jabber_sm_probe_unanswered(gpointer data)
+{
+	JabberStream *js = data;
+
+	js->sm_probe_timer = 0;
+
+	purple_debug_info("XEP-0198",
+	                  "Nothing answered in %d seconds, so the connection is gone\n",
+	                  PROBE_TIMEOUT_SECONDS);
+	purple_connection_error_reason(js->gc, PURPLE_CONNECTION_ERROR_NETWORK_ERROR,
+	                               _("Lost connection with server"));
+
+	return FALSE;
+}
+
+void
+jabber_sm_probe(JabberStream *js)
+{
+	if (js->sm_state != SM_ENABLED)
+		return;
+
+	/* One at a time: a second probe while the first is still waiting would only shorten the
+	   patience of the first. */
+	if (js->sm_probe_timer != 0)
+		return;
+
+	purple_debug_info("XEP-0198", "Asking whether the stream is still there\n");
+	jabber_sm_request_ack(js);
+
+	js->sm_probe_timer = purple_timeout_add_seconds(PROBE_TIMEOUT_SECONDS,
+	                                                jabber_sm_probe_unanswered, js);
+}
+
+/* Called when the stream is going away, because the timer would otherwise fire into a stream
+   that is no longer there. */
+void
+jabber_sm_stream_closing(JabberStream *js)
+{
+	if (js->sm_request_timer != 0) {
+		purple_timeout_remove(js->sm_request_timer);
+		js->sm_request_timer = 0;
+	}
+	if (js->sm_probe_timer != 0) {
+		purple_timeout_remove(js->sm_probe_timer);
+		js->sm_probe_timer = 0;
+	}
+}
