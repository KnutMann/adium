+/* Asks for the previous session back instead of binding a new resource. */
+gboolean
+jabber_sm_resume(JabberStream *js)
+{
+	JabberSmSession *session = jabber_sm_session_get(js);
+	xmlnode *resume;
+	char *h;
+
+	/* Nothing was put aside for us, so there is nothing to ask for. */
+	if (session->id == NULL)
+		return FALSE;
+
+	purple_debug_info("XEP-0198", "Asking for session %s back at %u\n",
+	                  session->id, session->inbound_count);
+
+	resume = xmlnode_new("resume");
+	xmlnode_set_namespace(resume, NS_STREAM_MANAGEMENT);
+	xmlnode_set_attrib(resume, "previd", session->id);
+	h = g_strdup_printf("%u", session->inbound_count);
+	xmlnode_set_attrib(resume, "h", h);
+	g_free(h);
+
+	jabber_send(js, resume);
+	xmlnode_free(resume);
+
+	js->sm_state = SM_RESUMING;
+	return TRUE;
+}
+
+/* The server took us back into the old session. */
+static void
+jabber_sm_resumed(JabberStream *js, xmlnode *packet)
+{
+	JabberSmSession *session = jabber_sm_session_get(js);
+	const char *ack_h = xmlnode_get_attrib(packet, "h");
+	GQueue *queue = session->queue;
+	guint length, i;
+
+	/* The counters are the old session's again. They were kept level with the stream that
+	   died, which is the only reason they are still here. */
+	js->sm_inbound_count = session->inbound_count;
+	js->sm_outbound_count = session->outbound_count;
+	js->sm_outbound_confirmed = session->outbound_confirmed;
+
+	/* No bind happened, so the address is the old one, and nothing else would restore it. */
+	if (session->full_jid != NULL) {
+		const char *slash = strchr(session->full_jid, '/');
+
+		purple_connection_set_display_name(js->gc, session->full_jid);
+		if (slash != NULL && js->user != NULL) {
+			g_free(js->user->resource);
+			js->user->resource = g_strdup(slash + 1);
+		}
+	}
+
+	/* Whatever the server confirms having received can go. */
+	if (ack_h != NULL) {
+		guint32 h = (guint32)strtoul(ack_h, NULL, 10);
+
+		for (i = js->sm_outbound_confirmed; i < h; i++) {
+			xmlnode *stanza = g_queue_pop_head(queue);
+
+			if (stanza == NULL)
+				break;
+			xmlnode_free(stanza);
+		}
+		js->sm_outbound_confirmed = h;
+		session->outbound_confirmed = h;
+	}
+
+	/* And the rest goes out again, while the state is still SM_RESUMING so that
+	   jabber_sm_outbound leaves it alone. These stanzas already carry their numbers from
+	   the old session; counting them a second time would put our idea of h permanently
+	   ahead of the server's, and from then on every acknowledgement would clear the wrong
+	   stanzas. They stay in the queue, because they are still unacknowledged. */
+	length = g_queue_get_length(queue);
+	if (length > 0)
+		purple_debug_info("XEP-0198", "Sending %u stanzas again\n", length);
+	for (i = 0; i < length; i++)
+		jabber_send(js, g_queue_peek_nth(queue, i));
+
+	js->sm_state = SM_ENABLED;
+	js->sm_resumed = TRUE;
+
+	purple_debug_info("XEP-0198", "The session was resumed; no new resource was bound\n");
+	jabber_stream_set_state(js, JABBER_STREAM_CONNECTED);
+}
