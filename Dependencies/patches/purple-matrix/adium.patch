+    /* A homeserver that only offers SSO (gitter.im, for one) never hands out a password login, so
+     * a token obtained in a browser is the only way in. It goes into the password field: the
+     * settings are plain text on disk, the password is the client's business (Adium keeps it in
+     * the keychain), and this switch only says how to read it. */
+    protocol_options = g_list_append(protocol_options,
+            purple_account_option_bool_new(
+                    _("The password is an access token "
+                      "(for homeservers that only offer SSO)"),
+                    PRPL_ACCOUNT_OPT_PASSWORD_IS_TOKEN, FALSE));
+
     prpl_info.protocol_options = protocol_options;
+
+    leave_cmd_id = purple_cmd_register("leave", "", PURPLE_CMD_P_PRPL,
+            PURPLE_CMD_FLAG_CHAT | PURPLE_CMD_FLAG_PRPL_ONLY, PRPL_ID,
+            _cmd_leave, _("leave:  Leave this room for good."), NULL);
 }
 
 static void matrixprpl_destroy(PurplePlugin *plugin) {
     purple_debug_info("matrixprpl", "shutting down\n");
+    if (leave_cmd_id) {
+        purple_cmd_unregister(leave_cmd_id);
+        leave_cmd_id = 0;
+    }
