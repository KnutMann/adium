@@ -319,8 +319,18 @@ static void _password_login(MatrixConnectionData *conn, PurpleAccount *acct)
 static void _whoami_error(MatrixConnectionData *conn,
         gpointer user_data, const gchar *error_message)
 {
-    PurpleAccount *acct = user_data;
+    /* user_data is the connection, which is what every caller passes; it used to be read as the
+     * account, so a stale token sent the fallback off with a pointer to the wrong struct. */
+    PurpleAccount *acct = conn->pc->account;
     purple_debug_info("matrixprpl", "_whoami_error: %s\n", error_message);
+
+    /* A token that was typed in as the password has no password to fall back to. */
+    if (purple_account_get_bool(acct, PRPL_ACCOUNT_OPT_PASSWORD_IS_TOKEN, FALSE)) {
+        purple_connection_error_reason(conn->pc,
+                PURPLE_CONNECTION_ERROR_AUTHENTICATION_FAILED,
+                _("The access token was not accepted"));
+        return;
+    }
     _password_login(conn, acct);
 }
 
