 /**
- * handle leaving a chat: notify the server that we are leaving, and
- * (ultimately) free the memory structures associated with it
+ * libpurple calls this when the conversation is destroyed, which a client does whenever the
+ * window closes. That used to leave the room on the server: close six windows, lose six rooms.
+ * Now it only frees what the conversation held; the next sync brings the room back, and leaving
+ * for good is the /leave command below.
  */
 static void matrixprpl_chat_leave(PurpleConnection *gc, int id) {
     PurpleConversation *conv = purple_find_chat(gc, id);
-    purple_debug_info("matrixprpl", "%s is leaving chat room %s\n",
+    purple_debug_info("matrixprpl", "%s closed chat room %s (still a member)\n",
                       gc->account->username, conv->name);
 
-    matrix_room_leave_chat(conv);
+    matrix_room_close_chat(conv);
+}
+
+static PurpleCmdId leave_cmd_id = 0;
+
+/**
+ * /leave: leave the room on the server. The conversation is marked as left, so what is typed
+ * into it afterwards goes nowhere, and closing the window then frees it as usual.
+ */
+static PurpleCmdRet _cmd_leave(PurpleConversation *conv, const gchar *cmd,
+        gchar **args, gchar **error, void *data)
+{
+    PurpleConnection *gc = purple_conversation_get_gc(conv);
+    MatrixConnectionData *conn = purple_connection_get_protocol_data(gc);
+
+    if (purple_conversation_get_type(conv) != PURPLE_CONV_TYPE_CHAT || conn == NULL)
+        return PURPLE_CMD_RET_FAILED;
+
+    purple_debug_info("matrixprpl", "%s is leaving chat room %s\n",
+                      gc->account->username, conv->name);
+    matrix_api_leave_room(conn, conv->name, NULL, NULL, NULL, NULL);
+    serv_got_chat_left(gc, purple_conv_chat_get_id(PURPLE_CONV_CHAT(conv)));
+    return PURPLE_CMD_RET_OK;
 }
 
 
