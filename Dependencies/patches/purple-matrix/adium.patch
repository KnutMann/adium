+void matrix_sync_room_from_state(PurpleConnection *pc,
+        const gchar *room_id, JsonArray *state_events)
+{
+    PurpleConversation *conv;
+
+    _ensure_blist_entry(pc->account, room_id);
+
+    conv = purple_find_conversation_with_account(
+            PURPLE_CONV_TYPE_CHAT, room_id, pc->account);
+    if(conv != NULL)
+        return;
+
+    purple_debug_info("matrixprpl", "Opening room %s from its state\n", room_id);
+    conv = matrix_room_create_conversation(pc, room_id);
+    if(state_events != NULL)
+        _parse_room_event_array(conv, state_events, TRUE);
+    matrix_room_complete_state_update(conv, FALSE);
+}
