+/**
+ * /leave: leave the room on the server. The conversation is marked as left, so what is typed
+ * into it afterwards goes nowhere, and closing the window then frees it as usual.
+ */
+static PurpleCmdRet _cmd_leave(PurpleConversation *conv, const gchar *cmd,
+        gchar **args, gchar **error, void *data)
+{
+    PurpleConnection *gc = purple_conversation_get_gc(conv);
+    MatrixConnectionData *conn = purple_connection_get_protocol_data(gc);
