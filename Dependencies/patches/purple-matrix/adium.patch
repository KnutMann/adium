     purple_connection_set_state(pc, PURPLE_CONNECTING);
     purple_connection_update_progress(pc, _("Logging in"), 0, 3);
 
-    if (access_token) {
+    if (purple_account_get_bool(acct, PRPL_ACCOUNT_OPT_PASSWORD_IS_TOKEN, FALSE)) {
+        /* The token is the password. It is never written into the settings, and one the plugin
+         * stored there after an earlier password login goes, for the same reason. */
+        const char *password = purple_account_get_password(acct);
+        purple_account_remove_setting(acct, PRPL_ACCOUNT_OPT_ACCESS_TOKEN);
+        if (!(password && *password)) {
+            purple_connection_error_reason(pc,
+                    PURPLE_CONNECTION_ERROR_AUTHENTICATION_FAILED,
+                    _("No access token: enter it as the password"));
+            return;
+        }
+        conn->access_token = g_strdup(password);
+        matrix_api_whoami(conn, _whoami_completed, _whoami_error,
+                _whoami_badresp, conn);
+    } else if (access_token && *access_token) {
+        /* "" is what a setting left empty comes back as, and it is not a token */
         conn->access_token = g_strdup(access_token);
         matrix_api_whoami(conn, _whoami_completed, _whoami_error,
                 _whoami_badresp, conn);
diff --git a/matrix-room.c b/matrix-room.c
index 4ac4684..63f2695 100644
--- a/matrix-room.c
+++ b/matrix-room.c
@@ -1157,28 +1157,16 @@ PurpleConversation *matrix_room_create_conversation(
  * Leave a chat: notify the server that we are leaving, and (ultimately)
  * free the memory structures
  */
-void matrix_room_leave_chat(PurpleConversation *conv)
+/* Drop everything this conversation holds, and tell the server nothing. This is what closing
+ * the window means: libpurple destroys the conversation and calls chat_leave, and a client
+ * window is not a membership. Leaving for good is /leave, see libmatrix.c. */
+void matrix_room_close_chat(PurpleConversation *conv)
 {
-    MatrixConnectionData *conn;
     MatrixRoomStateEventTable *state_table;
     GList *event_queue;
     MatrixRoomMemberTable *member_table;
 
-    conn = _get_connection_data_from_conversation(conv);
-
     _cancel_event_send(conv);
-    matrix_api_leave_room(conn, conv->name, NULL, NULL, NULL, NULL);
-
-    /* At this point, we have no confirmation that the 'leave' request will
-     * be successful (nor that it has even started), so it's questionable
-     * whether we can/should actually free all of the room state.
-     *
-     * On the other hand, we don't have any mechanism for telling purple that
-     * we haven't really left the room, and if the leave request does fail,
-     * we'll set the error flag on the connection, which will eventually
-     * result in pidgin flagging the connection as failed; things will
-     * hopefully then get resynced when the user reconnects.
-     */
 
     state_table = matrix_room_get_state_table(conv);
     matrix_statetable_destroy(state_table);
@@ -1196,6 +1184,27 @@ void matrix_room_leave_chat(PurpleConversation *conv)
     matrix_e2e_cleanup_conversation(conv);
 }
 
+void matrix_room_leave_chat(PurpleConversation *conv)
+{
+    MatrixConnectionData *conn;
+
+    conn = _get_connection_data_from_conversation(conv);
+
+    matrix_api_leave_room(conn, conv->name, NULL, NULL, NULL, NULL);
+
+    /* At this point, we have no confirmation that the 'leave' request will
+     * be successful (nor that it has even started), so it's questionable
+     * whether we can/should actually free all of the room state.
+     *
+     * On the other hand, we don't have any mechanism for telling purple that
+     * we haven't really left the room, and if the leave request does fail,
+     * we'll set the error flag on the connection, which will eventually
+     * result in pidgin flagging the connection as failed; things will
+     * hopefully then get resynced when the user reconnects.
+     */
+    matrix_room_close_chat(conv);
+}
+
 
