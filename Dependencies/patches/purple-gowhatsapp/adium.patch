         purple_blist_node_set_string(&chat->node, "picture_date", gwamsg->text);
+        gowhatsapp_remember_picture_type(gwamsg->account, &chat->node);
         return;
     }
 
@@ -57,6 +86,7 @@ gowhatsapp_handle_profile_picture(gowhatsapp_message_t *gwamsg)
     if (buddy != NULL) {
