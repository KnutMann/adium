+void gowhatsapp_for_all_chats(PurpleAccount *account, void(*func)(PurpleAccount *, PurpleChat *)) {
+    g_return_if_fail(account != NULL);
+
+    for (PurpleBlistNode *node = purple_blist_get_root();
+         node != NULL;
